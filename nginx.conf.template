# Rendered by the nginx image at startup (envsubst on ${API_UPSTREAM})
server {
    listen 80;
    root /usr/share/nginx/html;

    # Proxy API calls to planlos-server (used when VITE_API_BASE_URL=/api/v1)
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
    }

    # Always fetch the current settings.yml
    location = /settings.yml {
        add_header Cache-Control "no-cache";
    }

    # Single-page app: unknown paths go to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
