# Copy to .env and adjust. Never commit .env.

# Build (compose / Jenkins)
URL_BASE=/
VITE_API_BASE_URL=/api/v1
WEB_PORT=8002
# planlos-server as seen from the web container
API_UPSTREAM=http://host.docker.internal:8004
# Settings file for the Hilfe/Impressum/About dialogs mounted into the container
SETTINGS_FILE=./settings.yml

# Local dev server only (npm run dev): user sent as REMOTE_USER to the backend
VITE_SHIB_USERNAME=testuser
